# ============================================================
# Big Data Project - .gitignore
# ============================================================

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
*.egg

# --- Virtual Environment ---
venv/
env/
.env

# --- Data Files (too large for git) ---
data/raw/*.csv
data/raw/*.zip
data/processed/*.parquet
data/processed/*.csv

# --- Trained Models (too large for git) ---

# --- Spark Logs ---
spark-warehouse/
metastore_db/
derby.log
*.log

# --- IDE ---
.idea/
.vscode/
*.swp
*.swo

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini

# --- Jupyter ---
.ipynb_checkpoints/
*.ipynb_checkpoints

# --- Outputs ---
outputs/visualizations/*.png
